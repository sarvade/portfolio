---
import { getEntry } from 'astro:content';
import { skills } from '../data/profile';
import { url } from '../lib/url';

/*
  Skill cloud with category filters, modelled on the reference site: pick a
  category and its skills light up while the rest dim. "In case studies" lights
  every skill that links to a case study. Without JS every skill shows, undimmed.
*/

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const titles = new Map<string, string>();
for (const group of skills) {
  for (const skill of group.items) {
    if (skill.work && !titles.has(skill.work)) {
      const entry = await getEntry('work', skill.work);
      if (!entry) throw new Error(`Skill "${skill.name}" links to missing case study "${skill.work}"`);
      titles.set(skill.work, entry.data.title);
    }
  }
}
const total = skills.reduce((n, g) => n + g.items.length, 0);
const proven = skills.reduce((n, g) => n + g.items.filter((s) => s.work).length, 0);
---

<div class="skills" data-skills>
  <div class="skill-filters" role="group" aria-label="Filter skills by area">
    <button type="button" class="f-btn" data-cat="all" aria-pressed="true">All <span class="count">{total}</span></button>
    {
      skills.map((g) => (
        <button type="button" class="f-btn" data-cat={slug(g.group)} aria-pressed="false">
          {g.short} <span class="count">{g.items.length}</span>
        </button>
      ))
    }
    <button type="button" class="f-btn f-proven" data-cat="proven" aria-pressed="false">
      In case studies <span class="count">{proven}</span>
    </button>
  </div>

  <ul class="skill-cloud">
    {
      skills.flatMap((g) =>
        g.items.map((s) => (
          <li class="pill lit" data-cat={slug(g.group)} data-proven={s.work ? 'true' : 'false'}>
            {s.work ? (
              <a href={url(`work/${s.work}/`)} title={`Case study: ${titles.get(s.work)}`}>
                {s.name}
                <span class="proven-dot" aria-hidden="true" />
              </a>
            ) : (
              <span>{s.name}</span>
            )}
          </li>
        )),
      )
    }
  </ul>
  <p class="skills-legend"><span class="proven-dot" aria-hidden="true"></span> links to a case study where I used it</p>
  <p class="visually-hidden" aria-live="polite" data-skill-status></p>
</div>

<style>
  .skill-filters {
    display: none;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  :global(.js) .skill-filters {
    display: flex;
  }

  .f-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .f-btn:hover {
    color: var(--text);
    border-color: var(--rule-strong);
  }

  .f-btn[aria-pressed='true'] {
    color: var(--signal);
    border-color: var(--signal);
    background: color-mix(in srgb, var(--signal) 10%, transparent);
  }

  .count {
    min-width: 1.5em;
    padding: 0 0.4em;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .skill-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .pill > a,
  .pill > span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.45em 0.95em;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--text);
    font-size: var(--text-sm);
    line-height: 1.3;
    text-decoration: none;
  }

  .pill a {
    border-color: color-mix(in srgb, var(--signal) 45%, var(--rule));
  }

  .pill a:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .proven-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
  }

  /* Filter states */
  .pill.dim {
    opacity: 0.28;
  }

  .pill.glow > a,
  .pill.glow > span {
    border-color: var(--signal);
    background: color-mix(in srgb, var(--signal) 10%, transparent);
    box-shadow: 0 0 18px -2px color-mix(in srgb, var(--signal) 45%, transparent);
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pill,
    .pill > a,
    .pill > span {
      transition:
        opacity 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease,
        background-color 0.3s ease;
    }
  }

  .skills-legend {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-skills]');
  if (root) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.f-btn'));
    const pills = Array.from(root.querySelectorAll<HTMLElement>('.pill'));
    const status = root.querySelector<HTMLElement>('[data-skill-status]');

    const apply = (cat: string) => {
      let shown = 0;
      for (const pill of pills) {
        const on = cat === 'all' || pill.dataset.cat === cat || (cat === 'proven' && pill.dataset.proven === 'true');
        pill.classList.toggle('dim', !on);
        pill.classList.toggle('glow', on && cat !== 'all');
        if (on) shown++;
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.cat === cat));
      if (status) {
        const label = buttons.find((b) => b.dataset.cat === cat)?.firstChild?.textContent?.trim() ?? '';
        status.textContent = cat === 'all' ? `Showing all ${shown} skills` : `${label}: ${shown} skills highlighted`;
      }
    };

    for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.cat ?? 'all'));
  }
</script>

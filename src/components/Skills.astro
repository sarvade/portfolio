---
import { getEntry } from 'astro:content';
import { skills } from '../data/profile';
import { url } from '../lib/url';

const titles = new Map<string, string>();
for (const group of skills) {
  for (const skill of group.items) {
    if (skill.work && !titles.has(skill.work)) {
      const entry = await getEntry('work', skill.work);
      if (!entry) throw new Error(`Skill "${skill.name}" links to missing case study "${skill.work}"`);
      titles.set(skill.work, entry.data.title);
    }
  }
}
---

<div class="skills">
  {
    skills.map((group) => (
      <div class="skill-group">
        <h3>{group.group}</h3>
        <ul class="skill-list">
          {group.items.map((skill) =>
            skill.work ? (
              <li>
                <a href={url(`work/${skill.work}/`)} title={`Case study: ${titles.get(skill.work)}`}>
                  {skill.name}
                </a>
              </li>
            ) : (
              <li>
                <span>{skill.name}</span>
              </li>
            ),
          )}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .skills {
    display: grid;
    gap: var(--space-6) var(--space-6);
  }

  @media (min-width: 640px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .skill-group h3 {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule);
    font-size: var(--text-base);
    font-stretch: 110%;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .skill-list span,
  .skill-list a {
    display: inline-block;
    padding: 0.3em 0.7em;
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .skill-list span {
    color: var(--text);
  }

  .skill-list a {
    border-color: color-mix(in srgb, var(--signal) 55%, var(--rule));
    background: color-mix(in srgb, var(--signal) 9%, transparent);
    color: var(--signal);
    text-decoration: none;
  }

  .skill-list a:hover {
    border-color: var(--signal);
    color: var(--signal-strong);
  }
</style>

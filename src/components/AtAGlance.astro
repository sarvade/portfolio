---
import { glance, hero, site } from '../data/profile';
---

<aside class="glance" aria-label="At a glance">
  {
    hero.availability && (
      <p class="glance-status">
        <span class="status-dot" aria-hidden="true" />
        {hero.availability}
      </p>
    )
  }
  <dl>
    {
      glance.map((row) => (
        <div class="glance-row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))
    }
  </dl>
  <ul class="glance-links">
    <li><a href={site.links.linkedin}>LinkedIn</a></li>
    <li><a href={site.links.github}>GitHub</a></li>
    <li><a href={`mailto:${site.email}`}>Email</a></li>
  </ul>
</aside>

<style>
  .glance {
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--surface);
  }

  .glance-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
    font-weight: 600;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    flex: none;
  }

  dl {
    display: grid;
    gap: var(--space-3);
  }

  .glance-row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  dt {
    color: var(--text-muted);
  }

  dd {
    margin: 0;
    color: var(--text);
  }

  .glance-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--rule);
    list-style: none;
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>

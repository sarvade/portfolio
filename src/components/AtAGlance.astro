---
import Icon from './Icon.astro';
import { glance, hero, site } from '../data/profile';
---

<aside class="glance" aria-label="At a glance">
  {
    hero.availability && (
      <p class="glance-status">
        <span class="status-dot" aria-hidden="true" />
        {hero.availability}
      </p>
    )
  }
  <dl>
    {
      glance.map((row) => (
        <div class="glance-row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))
    }
  </dl>
  <ul class="glance-links">
    <li>
      <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn">
        <Icon name="brand-linkedin" size={20} />
      </a>
    </li>
    <li>
      <a href={site.links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)" title="GitHub">
        <Icon name="brand-github" size={20} />
      </a>
    </li>
    <li>
      <a href="#contact" aria-label="Email" title="Email">
        <Icon name="mail" size={20} />
      </a>
    </li>
  </ul>
</aside>

<style>
  .glance {
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--surface);
  }

  .glance-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
    font-weight: 600;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    flex: none;
  }

  dl {
    display: grid;
    gap: var(--space-3);
  }

  .glance-row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  dt {
    color: var(--text-muted);
  }

  dd {
    margin: 0;
    color: var(--text);
  }

  .glance-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .glance-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
  }

  .glance-links a:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

</style>

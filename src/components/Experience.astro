---
import { getEntry } from 'astro:content';
import { experience } from '../data/profile';
import { url } from '../lib/url';

// Resolve case-study titles once so links have descriptive accessible names.
const titles = new Map<string, string>();
for (const job of experience) {
  for (const h of job.highlights) {
    if (h.work && !titles.has(h.work)) {
      const entry = await getEntry('work', h.work);
      if (!entry) throw new Error(`Experience links to missing case study "${h.work}"`);
      titles.set(h.work, entry.data.title);
    }
  }
}

// Each job shows its picked highlights; the rest open with "Show all" (native
// <details>, so it works without JavaScript). Without picks, the first 3 show.
const split = (job: (typeof experience)[number]) => {
  const picked = job.highlights.filter((h) => h.shown);
  const shown = picked.length > 0 ? picked : job.highlights.slice(0, 3);
  return { shown, more: job.highlights.filter((h) => !shown.includes(h)) };
};
---

<ol class="timeline">
  {
    experience.map((job) => {
      const { shown, more } = split(job);
      return (
      <li class="job" id={`experience-${job.id}`}>
        <p class="job-when">
          {job.start} to {job.end}
        </p>
        <div class="job-main">
          <h3>
            {job.role}, {job.company}
          </h3>
          <p class="job-where">{job.location}</p>
          {job.context && <p class="job-context">{job.context}</p>}
          <ul class="job-highlights">
            {shown.map((h) => (
              <li>
                {h.text}
                {h.work && (
                  <>
                    {' '}
                    <a class="case-link" href={url(`work/${h.work}/`)} aria-label={`Case study: ${titles.get(h.work)}`}>
                      Case study
                    </a>
                  </>
                )}
              </li>
            ))}
          </ul>
          {more.length > 0 && (
            <details class="job-more">
              <summary>
                <span class="when-closed">Show all {job.highlights.length}</span>
                <span class="when-open">Show fewer</span>
              </summary>
              <ul class="job-highlights">
                {more.map((h) => (
                  <li>
                    {h.text}
                    {h.work && (
                      <>
                        {' '}
                        <a class="case-link" href={url(`work/${h.work}/`)} aria-label={`Case study: ${titles.get(h.work)}`}>
                          Case study
                        </a>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          )}
        </div>
      </li>
      );
    })
  }
</ol>

<style>
  .timeline {
    padding: 0;
    list-style: none;
  }

  .job {
    position: relative;
    display: grid;
    gap: var(--space-2) var(--space-6);
    padding-left: var(--space-5);
    padding-bottom: var(--space-7);
    border-left: 1px solid var(--rule-strong);
  }

  .job:last-child {
    padding-bottom: 0;
  }

  /* Marker on the timeline */
  .job::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.45em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--signal);
  }

  .job-when {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .job-where {
    margin-top: var(--space-1);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .job-context {
    margin-top: var(--space-3);
    max-width: 60ch;
  }

  .job-highlights {
    margin-top: var(--space-4);
    padding-left: 1.1em;
    list-style: disc;
    max-width: 66ch;
  }

  .job-highlights li + li {
    margin-top: var(--space-3);
  }

  .job-highlights li::marker {
    color: var(--rule-strong);
  }

  .case-link {
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
  }

  /* "Show all": the hidden highlights continue the list above */
  .job-more {
    margin-top: var(--space-3);
    max-width: 66ch;
  }

  .job-more > .job-highlights {
    margin-top: var(--space-3);
  }

  .job-more summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    color: var(--signal);
    font-size: var(--text-sm);
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }

  .job-more summary::-webkit-details-marker {
    display: none;
  }

  /* Chevron that turns when open */
  .job-more summary::after {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-0.12em) rotate(45deg);
  }

  .job-more[open] summary::after {
    transform: translateY(0.12em) rotate(-135deg);
  }

  .job-more summary:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .job-more summary:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .job-more[open] .when-closed,
  .job-more:not([open]) .when-open {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .job-more summary::after {
      transition: transform 0.2s ease;
    }

    .job-more[open] > .job-highlights {
      animation: more-in 0.3s ease;
    }
  }

  @keyframes more-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (min-width: 720px) {
    .job {
      grid-template-columns: 9.5rem minmax(0, 1fr);
    }

    .job-when {
      padding-top: 0.2em;
    }
  }
</style>

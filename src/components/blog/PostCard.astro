---
/*
  One post as a card for the blog index. The title link is stretched over the
  whole card with a pseudo-element, so the card is one click target but there is
  only one link for keyboard and screen-reader users.
  featured: the newest post, drawn larger across the full grid width.
*/
import type { PostEntry } from '../../lib/content';
import { url } from '../../lib/url';
import { formatDate, isoDate, readingTime } from '../../lib/format';

interface Props {
  post: PostEntry;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
---

<article class:list={['card', { featured }]}>
  {featured && <p class="kicker">Latest</p>}
  <h2 class="card-title">
    <a href={url(`blog/${post.id}/`)}>{title}</a>
  </h2>
  <p class="card-desc">{description}</p>
  <p class="card-meta">
    <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
    <span aria-hidden="true">/</span>
    <span>{readingTime(post.body)}</span>
    {draft && <span class="draft">Draft</span>}
  </p>
  {
    tags.length > 0 && (
      <ul class="card-tags" aria-label="Tags">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--surface);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--rule-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        border-color 0.15s ease,
        transform 0.15s ease;
    }

    .card:hover {
      transform: translateY(-2px);
    }
  }

  .kicker {
    color: var(--signal);
    font-size: var(--text-sm);
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-title {
    font-size: var(--text-md);
    font-stretch: 106%;
    font-weight: 650;
    line-height: 1.25;
  }

  .featured .card-title {
    font-size: var(--text-xl);
    font-stretch: 112%;
    max-width: 30ch;
  }

  .card-title a {
    color: var(--text);
    text-decoration: none;
  }

  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .card:has(.card-title a:focus-visible) {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }

  .card-desc {
    color: var(--text-muted);
  }

  .featured .card-desc {
    max-width: 68ch;
    font-size: var(--text-base);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .draft {
    color: var(--caution);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .card-tags li {
    padding: 0.2em 0.6em;
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.3;
  }
</style>

---
/*
  Architecture diagram for a case study: layers left to right (source, compute,
  storage, serving, or whatever the system's real path is), plus a band of the
  checks that guard it. Stacks top to bottom on narrow screens.

  Plain HTML lists, so it reads without CSS or JS and to screen readers.
  It spans the full article width rather than the text column, so it needs an
  ancestor with `container-type: inline-size` (the case-study page sets one).

  tone: 'signal' highlights the key component, 'caution' marks where it broke,
  'muted' marks something legacy or being retired.
*/
export interface Node {
  label: string;
  note?: string;
  tone?: 'default' | 'signal' | 'caution' | 'muted';
}

export interface Layer {
  name: string;
  nodes: Node[];
}

interface Props {
  title: string;
  layers: Layer[];
  checks?: { name?: string; nodes: Node[] };
  caption?: string;
}

const { title, layers, checks, caption } = Astro.props;
---

<figure class="arch">
  <p class="arch-head"><span class="arch-kicker">Architecture</span><span class="arch-title">{title}</span></p>
  <ol class="arch-layers" style={`--cols: ${layers.length}`}>
    {
      layers.map((layer, i) => (
        <li class="layer">
          <p class="layer-name">
            <span class="layer-num" aria-hidden="true">{i + 1}</span>
            {layer.name}
          </p>
          <ul class="layer-nodes">
            {layer.nodes.map((node) => (
              <li class:list={['node', `tone-${node.tone ?? 'default'}`]}>
                <span class="node-label">{node.label}</span>
                {node.note && <span class="node-note">{node.note}</span>}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
  {
    checks && (
      <div class="arch-checks">
        <p class="layer-name checks-name">{checks.name ?? 'Validation'}</p>
        <ul class="check-nodes">
          {checks.nodes.map((node) => (
            <li class:list={['check', `tone-${node.tone ?? 'default'}`]}>
              <span class="node-label">{node.label}</span>
              {node.note && <span class="node-note">{node.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .arch {
    width: min(100cqw, var(--container));
    max-width: none;
    margin-block: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background-color: var(--surface);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .arch-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-5);
  }

  .arch-kicker {
    color: var(--signal);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .arch-title {
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .arch-layers {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Reset the article's list spacing; layout here comes from gap. */
  .layer,
  .node,
  .check {
    margin: 0;
  }

  .layer {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  /* Connector between layers: down on narrow screens */
  .layer + .layer::before {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(-1 * var(--space-6) + 4px);
    width: 1.5px;
    height: calc(var(--space-6) - 8px);
    background: var(--rule-strong);
    transform: translateX(-50%);
  }

  .layer + .layer::after {
    content: '';
    position: absolute;
    left: 50%;
    top: -9px;
    border: 5px solid transparent;
    border-top-color: var(--rule-strong);
    transform: translateX(-50%);
  }

  .layer-name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .layer-num {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    color: var(--text);
    font-size: 0.6875rem;
    letter-spacing: 0;
  }

  .layer-nodes,
  .check-nodes {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .node,
  .check {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    border: 1.25px solid var(--rule-strong);
    border-radius: 8px;
    background: var(--bg);
  }

  .node-label {
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 650;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .node-note {
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .tone-signal {
    border-color: var(--signal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--signal) 14%, transparent);
  }

  .tone-caution {
    border-color: var(--caution);
    background: color-mix(in srgb, var(--caution) 8%, var(--bg));
  }

  .tone-muted {
    border-style: dashed;
  }

  .tone-muted .node-label {
    color: var(--text-muted);
  }

  /* Checks band: guards the whole path */
  .arch-checks {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding: var(--space-4);
    border: 1.25px dashed color-mix(in srgb, var(--signal) 55%, var(--rule-strong));
    border-radius: 10px;
    background: color-mix(in srgb, var(--signal) 5%, transparent);
  }

  .checks-name {
    color: var(--signal);
  }

  .check {
    background: var(--surface);
  }

  figcaption {
    margin-top: var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* Wide enough for one row of layers, arrows pointing right */
  @container (min-width: 760px) {
    .arch-layers {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      gap: var(--space-6);
    }

    .layer + .layer::before {
      left: calc(-1 * var(--space-6) + 6px);
      top: calc(50% + 0.9rem);
      width: calc(var(--space-6) - 12px);
      height: 1.5px;
      transform: translateY(-50%);
    }

    .layer + .layer::after {
      left: -11px;
      top: calc(50% + 0.9rem);
      border-top-color: transparent;
      border-left-color: var(--rule-strong);
      transform: translateY(-50%);
    }

    .layer-nodes {
      flex: 1;
      justify-content: center;
    }

    .arch-checks {
      flex-direction: row;
      align-items: center;
      gap: var(--space-4);
    }

    .checks-name {
      flex: none;
      width: 7rem;
    }

    .check-nodes {
      flex: 1;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .check {
      flex: 1 1 12rem;
    }
  }
</style>

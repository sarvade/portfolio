---
/*
  Partition strip: one row per scenario, one cell per partition (for example a
  day). Each character of `cells` is a legend key, so 30 days fit in one short
  string. Cells listed in `marks` (or 'all') were rewritten by that scenario and
  are drawn taller, so the picture reads without color too.

  The meaning lives in each row's label and note; the cells are decoration for
  screen readers. Cells grow in when the figure scrolls into view (skipped with
  reduced motion or without JavaScript).
*/
interface LegendItem {
  key: string;
  label: string;
  tone: 'signal' | 'caution' | 'empty' | 'muted';
}

interface Row {
  label: string;
  cells: string;
  marks?: number[] | 'all';
  note?: string;
}

interface Props {
  title: string;
  rows: Row[];
  legend: LegendItem[];
  /** Labels under the strip, spread evenly (usually the first and last partition). */
  axis?: string[];
  caption?: string;
}

const { title, rows, legend, axis = [], caption } = Astro.props;
const tones = Object.fromEntries(legend.map((item) => [item.key, item.tone]));
const isMarked = (row: Row, index: number) => row.marks === 'all' || (row.marks ?? []).includes(index);
---

<figure class="parts" data-parts>
  <p class="parts-title">{title}</p>

  <ul class="parts-legend">
    {
      legend.map((item) => (
        <li>
          <span class:list={['swatch', `tone-${item.tone}`]} aria-hidden="true" />
          {item.label}
        </li>
      ))
    }
    <li>
      <span class="swatch swatch-tall" aria-hidden="true"></span>
      Taller: rewritten in that row
    </li>
  </ul>

  <ol class="parts-rows">
    {
      rows.map((row, r) => (
        <li class="parts-row" style={`--r: ${r}`}>
          <p class="parts-label">{row.label}</p>
          <div class="parts-cells" style={`--n: ${row.cells.length}`} aria-hidden="true">
            {[...row.cells].map((key, i) => (
              <span
                class:list={['cell', `tone-${tones[key] ?? 'muted'}`, { marked: isMarked(row, i) }]}
                style={`--i: ${i}`}
              />
            ))}
          </div>
          {row.note && <p class="parts-note">{row.note}</p>}
        </li>
      ))
    }
  </ol>

  {
    axis.length > 0 && (
      <div class="parts-axis" aria-hidden="true">
        {axis.map((label) => (
          <span>{label}</span>
        ))}
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const figures = document.querySelectorAll<HTMLElement>('[data-parts]');
  if (!reduce.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.25 },
    );
    for (const figure of figures) {
      figure.classList.add('is-armed');
      observer.observe(figure);
    }
  }
</script>

<style>
  .parts {
    margin-block: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--surface);
  }

  .parts-title {
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .parts-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .parts-legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }

  .swatch-tall {
    width: 8px;
    height: 16px;
    border: 1.5px solid var(--text-muted);
    border-radius: 2px;
  }

  .parts-rows {
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .parts-row {
    margin: 0;
  }

  .parts-row + .parts-row {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .parts-label {
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.35;
  }

  .parts-cells {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    align-items: end;
    gap: 3px;
    height: 26px;
    margin-top: var(--space-2);
  }

  .cell {
    display: block;
    height: 16px;
    border-radius: 2px;
    transform-origin: bottom center;
    forced-color-adjust: none;
  }

  .cell.marked {
    height: 26px;
  }

  .parts-note {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  /* Tones (shared by cells and legend swatches) */
  .tone-signal {
    background: var(--signal);
  }

  /* Stripes, so "old" and "new" differ in more than hue */
  .tone-caution {
    background: repeating-linear-gradient(
      135deg,
      var(--caution) 0 3px,
      color-mix(in srgb, var(--caution) 45%, var(--surface)) 3px 6px
    );
  }

  .tone-empty {
    border: 1.5px dashed var(--rule-strong);
    background: transparent;
  }

  .tone-muted {
    background: var(--rule-strong);
  }

  .parts-axis {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  figcaption {
    margin-top: var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* Grow-in: armed by the script, played once when visible */
  .parts.is-armed .cell {
    transform: scaleY(0);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--r) * 160ms + var(--i) * 14ms);
  }

  .parts.is-armed.is-in .cell {
    transform: scaleY(1);
  }

  @media (max-width: 479px) {
    .parts-cells {
      gap: 2px;
    }
  }
</style>

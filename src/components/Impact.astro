---
import { scale } from '../data/profile';
/*
  "Scale I work at": a compact row of context numbers under the hero. Results
  live in Selected work, so each number appears on the page once.
  Numbers count up once when they first scroll into view. The final values are
  in the HTML, so they show without JS and with reduced motion.
*/
type Item = { value: string; label: string; count?: number; prefix?: string; suffix?: string };
const decimals = (item: Item) => (item.count !== undefined && !Number.isInteger(item.count) ? 1 : 0);
---

<section class="impact" aria-labelledby="scale-title">
  <div class="container">
    <div class="band band-scale">
      <h2 id="scale-title" class="band-title">Scale I work at</h2>
      <ul class="scale-grid">
        {
          (scale as Item[]).map((item) => (
            <li class="scale-item">
              <span
                class="scale-value count-up"
                data-count={item.count}
                data-prefix={item.prefix ?? ''}
                data-suffix={item.suffix ?? ''}
                data-decimals={decimals(item)}
              >
                {item.value}
              </span>
              <span class="scale-label">{item.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .impact {
    border-top: 1px solid var(--rule);
    background: color-mix(in srgb, var(--surface) 55%, var(--bg));
  }

  .band-title {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 650;
    font-stretch: 100%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Scale: compact context row */
  .band-scale {
    padding-block: var(--space-6);
  }

  .scale-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .scale-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-3);
    border-left: 2px solid color-mix(in srgb, var(--signal) 55%, var(--rule));
  }

  .scale-value {
    color: var(--text);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 740;
    font-stretch: 120%;
    letter-spacing: -0.01em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums lining-nums;
    text-wrap: balance;
  }

  .scale-label {
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  @media (min-width: 700px) {
    .scale-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .scale-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const values = Array.from(document.querySelectorAll<HTMLElement>('.count-up[data-count]'));

  if (!reduce.matches && values.length && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const decimals = Number(el.dataset.decimals ?? 0);
      const prefix = el.dataset.prefix ?? '';
      const suffix = el.dataset.suffix ?? '';
      const final = el.textContent;
      const start = performance.now();
      const duration = 1100;
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = `${prefix}${(target * eased).toFixed(decimals)}${suffix}`;
        if (t < 1) requestAnimationFrame(step);
        else el.textContent = final;
      };
      requestAnimationFrame(step);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            run(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.6 },
    );
    values.forEach((el) => observer.observe(el));
  }
</script>

---
/*
  Blog index at /portfolio/blog/.
  It is only generated once at least one post exists, so there is never an
  empty page to find or index.
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getPosts, type PostEntry } from '../../lib/content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  if (posts.length === 0) return [];
  return [{ params: { page: undefined }, props: { posts } }];
}

interface Props {
  posts: PostEntry[];
}
const { posts } = Astro.props;
---

<BaseLayout title="Blog" description="Notes on data engineering and AI by Sai S Sarvade: validation, reruns, query plans, and where LLMs help.">
  <div class="container blog-index">
    <a class="back" href={url('#blog')}>Back to the home page</a>
    <header>
      <h1>Blog</h1>
      <p>Notes from building pipelines: validation, reruns, query plans, and where AI actually helps. New posts roughly once a week.</p>
    </header>
    <ul class="post-grid" role="list">
      {
        posts.map((post, i) => (
          <li class:list={{ wide: i === 0 }}>
            <PostCard post={post} featured={i === 0} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .blog-index {
    padding-top: var(--space-7);
    padding-bottom: var(--space-9);
  }

  .back {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  header {
    margin-top: var(--space-6);
    margin-bottom: var(--space-6);
  }

  header p {
    max-width: 62ch;
    margin-top: var(--space-3);
    color: var(--text-muted);
  }

  /* Cards fill the width: 1 column on phones, 2 on tablets and laptops, 3 on large screens.
     The newest post spans the whole row. */
  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1240px) {
    .post-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .post-grid > .wide {
    grid-column: 1 / -1;
  }
</style>

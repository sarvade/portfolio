---
import BaseLayout from '../layouts/BaseLayout.astro';
import PipelineDiagram from '../components/PipelineDiagram.astro';
import AtAGlance from '../components/AtAGlance.astro';
import Approach from '../components/Approach.astro';
import HeroNetwork from '../components/HeroNetwork.astro';
import Typewriter from '../components/Typewriter.astro';
import WorkList from '../components/WorkList.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import PostList from '../components/PostList.astro';
import Impact from '../components/Impact.astro';
import { hero, site } from '../data/profile';

// The headline renders as two lines: up to and including the first period, then the rest.
const cut = hero.headline.indexOf('. ');
const headlineLines = cut > 0 ? [hero.headline.slice(0, cut + 1), hero.headline.slice(cut + 2)] : [hero.headline];
import { getCaseStudies, getProjects, getPosts } from '../lib/content';
import { url, absoluteUrl } from '../lib/url';

const allCaseStudies = await getCaseStudies();
const caseStudies = allCaseStudies.filter((entry) => entry.data.featured);
const projects = await getProjects();
const posts = (await getPosts()).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  worksFor: { '@type': 'Organization', name: 'TikTok' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Rice University' },
    { '@type': 'CollegeOrUniversity', name: 'Amrita Vishwa Vidyapeetham' },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'San Jose', addressRegion: 'CA', addressCountry: 'US' },
  url: absoluteUrl('', Astro.site),
  sameAs: [site.links.linkedin, site.links.github],
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <HeroNetwork />
    <div class="container hero-inner">
      <div class="hero-grid">
        <div class="hero-main">
          <p class="hero-kicker load-in" style="--d: 0.05s">
            Hi, I’m <span class="hero-name">Sai Sarvade</span>, <Typewriter roles={hero.roles} />
          </p>
          <h1 id="hero-title" class="load-in" style="--d: 0.15s">
            {headlineLines.map((line, i) => <span class:list={['h1-line', i === 1 && 'h1-accent']}>{line} </span>)}
          </h1>
          <p class="hero-intro load-in" style="--d: 0.25s">{hero.intro}</p>
          <div class="hero-actions load-in" style="--d: 0.35s">
            <a class="btn btn-primary" href="#work">See selected work</a>
            <a class="btn btn-quiet" href={url(site.resume)} target="_blank" rel="noopener"
              >Résumé (PDF)<span class="visually-hidden"> (opens in a new tab)</span></a
            >
          </div>
        </div>
        <div class="load-in" style="--d: 0.45s">
          <AtAGlance />
        </div>
      </div>
      <div class="load-in" style="--d: 0.55s">
        <PipelineDiagram />
      </div>
    </div>
  </section>

  <Impact />

  <section id="work" class="section" aria-labelledby="work-title">
    <div class="container section-grid reveal">
      <div class="section-head">
        <h2 id="work-title">Selected work</h2>
        <p>Case studies from TikTok and Delta Air Lines: the stakes, the architecture, the trade-offs, what broke, and what I’d do differently now. Internal names and details are left out on purpose.</p>
      </div>
      <div>
        <WorkList items={caseStudies} />
        <a class="all-link" href={url('work/')}>View all {allCaseStudies.length} case studies →</a>
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section id="blog" class="section" aria-labelledby="blog-title">
        <div class="container section-grid reveal">
          <div class="section-head">
            <h2 id="blog-title">Blog</h2>
            <p>Notes from building pipelines: validation, reruns, query plans, and where AI helps.</p>
          </div>
          <div>
            <PostList posts={posts} />
            <a class="all-link" href={url('blog/')}>All posts</a>
          </div>
        </div>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section id="projects" class="section" aria-labelledby="projects-title">
        <div class="container section-grid reveal">
          <div class="section-head">
            <h2 id="projects-title">Projects</h2>
            <p>Things I have built on my own time.</p>
          </div>
          <WorkList items={projects} />
        </div>
      </section>
    )
  }

  <section id="experience" class="section" aria-labelledby="experience-title">
    <div class="container section-grid reveal">
      <div class="section-head">
        <h2 id="experience-title">Experience</h2>
        <p>5+ years building data pipelines, canonical datasets, and the checks that keep them correct.</p>
      </div>
      <Experience />
    </div>
  </section>

  <section id="approach" class="section" aria-labelledby="approach-title">
    <div class="container section-grid reveal">
      <div class="section-head">
        <h2 id="approach-title">Approach</h2>
        <p>The habits behind the work above. Some come with the pattern they boil down to; the snippets are illustrative, not production code.</p>
      </div>
      <Approach />
    </div>
  </section>

  <section id="skills" class="section" aria-labelledby="skills-title">
    <div class="container section-grid reveal">
      <div class="section-head">
        <h2 id="skills-title">Skills</h2>
        <p>Filter by area. Skills with a dot link to a case study where I used them.</p>
      </div>
      <Skills />
    </div>
  </section>

  <section id="about" class="section" aria-labelledby="about-title">
    <div class="container section-grid reveal">
      <div class="section-head">
        <h2 id="about-title">About</h2>
      </div>
      <About />
    </div>
  </section>


  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="container section-grid reveal">
      <div class="section-head">
        <h2 id="contact-title">Get in touch</h2>
        <p>Email is the fastest way to reach me.</p>
      </div>
      <Contact />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3rem, 1.5rem + 6vw, 7rem);
    padding-bottom: var(--space-8);
    /* Soft glows behind the headline and the card */
    background:
      radial-gradient(60rem 36rem at 20% 0%, color-mix(in srgb, var(--signal) 9%, transparent), transparent 70%),
      radial-gradient(28rem 22rem at 88% 30%, color-mix(in srgb, var(--signal) 6%, transparent), transparent 70%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-kicker {
    margin-bottom: var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-md);
    line-height: 1.4;
    min-height: 1.4em;
  }

  @media (max-width: 519px) {
    .hero-kicker :global(.typewriter) {
      display: block;
    }
  }

  /* The name: a slow, seamless spectrum. Static under reduced motion. */
  .hero-name {
    color: var(--text);
    font-weight: 700;
    background-image: linear-gradient(90deg, var(--spectrum));
    background-size: 200% 100%;
    background-repeat: repeat-x;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-name {
      animation: spectrum-flow 9s linear infinite;
    }
  }

  @keyframes spectrum-flow {
    to {
      background-position: 200% 0;
    }
  }

  @media (forced-colors: active) {
    .hero-name {
      background: none;
      -webkit-text-fill-color: CanvasText;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .load-in {
      animation: load-in 0.7s ease both;
      animation-delay: var(--d, 0s);
    }
  }

  .all-link {
    display: inline-block;
    margin-top: var(--space-5);
    font-weight: 600;
  }

  @keyframes load-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  .hero-grid {
    display: grid;
    gap: var(--space-7);
    align-items: end;
  }

  @media (min-width: 1080px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(19rem, 24rem);
      gap: var(--space-8);
    }
  }

  .hero h1 {
    max-width: 20ch;
    font-size: var(--text-hero);
    font-stretch: 125%;
    font-weight: 760;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .h1-line {
    display: block;
    text-wrap: balance;
  }

  .h1-accent {
    color: var(--signal);
  }

  .hero-intro {
    max-width: 58ch;
    margin-top: var(--space-5);
    color: var(--text-muted);
    font-size: var(--text-md);
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <div class="container not-found">
    <h1>This page isn’t here.</h1>
    <p>The link may be out of date, or the address may have a typo.</p>
    <p><a class="btn btn-primary" href={url()}>Go to the home page</a></p>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-9);
  }

  .not-found p {
    margin-top: var(--space-4);
    color: var(--text-muted);
  }

  .not-found p:last-child {
    margin-top: var(--space-6);
  }
</style>
